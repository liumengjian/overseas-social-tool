# ===== 海外社媒运营工具 配置模板 =====
# 复制为 .env 并填写真实令牌：
#   cp .env.example .env
# 也可在应用内「九、设置」页填写（保存后优先于 .env，无需重启）。

# ---- TiKhub 数据接口 ----
# 在 https://user.tikhub.io/dashboard 获取
TIKHUB_API_TOKEN=
# 大陆网络可改用 https://api.tikhub.dev
TIKHUB_BASE_URL=https://api.tikhub.io

# ---- LLM 大模型（OpenAI 兼容，默认 MiniMax-M3）----
# 在 https://platform.minimax.io 获取（或任意 OpenAI 兼容 Key）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# ---- 抓取参数 ----
# 单页抓取视频数量上限（默认 30，最大按平台限制）
FETCH_VIDEO_COUNT=30
