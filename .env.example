# ===== 海外社媒运营工具 配置模板 =====
# 复制为 .env 并填写真实令牌：
#   cp .env.example .env
# 也可在应用内「十一、设置」页填写（保存后优先于 .env，无需重启）。

# ---- TiKhub 数据接口 ----
# 在 https://user.tikhub.io/dashboard 获取
TIKHUB_API_TOKEN=
# 大陆网络可改用 https://api.tikhub.dev
TIKHUB_BASE_URL=https://api.tikhub.io

# ---- 视频解析大模型（OpenAI 兼容）----
# 可填写任意 OpenAI 兼容服务的 Key、地址和模型名
VIDEO_API_KEY=
VIDEO_BASE_URL=https://api.new.bi/v1
VIDEO_MODEL=gemini-3.1-pro-preview
# 口播转写默认使用标准 OpenAI 兼容接口，不会请求 /files/upload。
# 若服务商要求文件多模态，可按服务商文档配置文件上传路径。
LLM_FILE_UPLOAD_PATH=/files/upload

# ---- 客服 SOP 对话模型（火山方舟）----
SOP_API_KEY=
SOP_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SOP_MODEL=doubao-seed-2-0-lite-260215

# ---- 生图大模型（OpenAI 兼容，默认 gpt-image-2-1k）----
IMAGE_API_FORMAT=openai
IMAGE_BASE_URL=https://api.new.bi/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2-1k
IMAGE_MAX_RESOLUTION=1k
IMAGE_GENERATE_PATH=/images/generations
IMAGE_EDIT_PATH=/images/edits
IMAGE_BODY_MODE=json
IMAGE_EDIT_STYLE=auto
IMAGE_ADVANCED_PARAMS=

# ---- 抓取参数 ----
# 单页抓取视频数量上限（默认 30，最大按平台限制）
FETCH_VIDEO_COUNT=30

# ---- MySQL 云端缓存（热点 / 账号分析 / 爆款拆解 结果缓存）----
# 留空 MYSQL_HOST 则禁用云端缓存；应用启动后自动创建 api_cache 表。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ---- 腾讯云 COS（AI 生图模板图片）----
# 模板图片固定上传至 COS Bucket 的 bt/tools/ 目录。请勿把真实密钥提交到仓库。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 可选：上传成功后用于生成访问地址；例如 https://bucket.cos.ap-shanghai.myqcloud.com
COS_CDN_DOMAIN=
# Whisper 模型公开下载地址；默认使用 COS_CDN_DOMAIN/tools/ggml-base.bin
WHISPER_MODEL_URL=

# ---- 缓存过期天数（0 = 禁用该类型缓存）----
# 热点与 Tag 追踪结果缓存天数（默认 1 = 当天有效）
HOTSPOT_CACHE_DAYS=1
# 竞对 / 自身账号分析结果缓存天数（默认 7）
ACCOUNT_CACHE_DAYS=7

# ---- yt-dlp（在线视频链接 → 可播放直链，供爆款拆解「链接直连」使用）----
# 默认 'yt-dlp'（从系统 PATH 查找），可填完整路径；未安装时链接拆解回退三方接口直链。
# 下载：https://github.com/yt-dlp/yt-dlp
YTDLP_PATH=yt-dlp
