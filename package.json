{
  "name": "overseas-social-tool",
  "version": "0.1.0",
  "description": "海外社媒智能运营桌面工具 — 竞对分析/视频数据库/热点追踪/爆款拆解/高转化分析/AI剪辑/TikTok CRM",
  "main": "dist-electron/main/main.js",
  "author": "WorkBuddy",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "electron:dev": "tsc -p tsconfig.node.json && vite build && electron .",
    "electron:start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^16.4.5",
    "node-edge-tts": "^2.0.7",
    "ffmpeg-static": "^5.2.0",
    "mysql2": "^3.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.workbuddy.overseas-social-tool",
    "productName": "海外社媒智能运营工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "resources/yt-dlp",
        "to": "yt-dlp"
      },
      {
        "from": "resources/whisper",
        "to": "whisper"
      },
      {
        "from": "resources/vc_redist.x64.exe",
        "to": "vc_redist.x64.exe"
      },
      {
        "from": "static/font",
        "to": "static/font"
      }
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
